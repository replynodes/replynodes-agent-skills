{
  "manifest_kind": "replynodes/social-data-skills/appstore-data-api-package-manifest",
  "manifest_version": 1,
  "name": "appstore-data-api",
  "title": "App Store Public Reads",
  "description": "Read-only access to public App Store application data: application lookup, developer catalog, storefront chart listings, privacy label, ratings summaries, paged reviews, bounded term search, related-app listings, and type-ahead suggestions \u2014 nine capabilities via one HTTPS gateway. Requests use Bearer workspace-key authentication or truthful x402 v2 payment negotiation when the service returns HTTP 402. No purchase, review, account, login, or other mutation is supported.",
  "version": "1.0.12",
  "contract_version": "v1",
  "platform": "ios",
  "mode": "readonly",
  "license": "Apache-2.0",
  "entrypoint": "SKILL.md",
  "install_doc": "INSTALL.md",
  "publication_doc": "PUBLICATION.md",
  "required_agents": [
    "OpenClaw",
    "Hermes",
    "ChatGPT",
    "Claude",
    "generic HTTP",
    "MCP agents"
  ],
  "search_terms": [
    "app store",
    "appstore",
    "ios",
    "app lookup",
    "app search",
    "related apps",
    "app metadata",
    "public app data"
  ],
  "surface_status": [
    "This package documents nine stable, read-only GET operations with bounded requests and normalized v1 responses.",
    "The public routes are stable capability identifiers for agent tool bindings.",
    "No availability, uptime, latency, success-rate, or payment-settlement claim is made; example payloads are illustrative fixtures."
  ],
  "source_of_truth": {
    "repository": "replynodes/replynodes-agent-skills",
    "path": "skills/appstore-api",
    "purpose": "Public sanitized provenance for the App Store read-skill package and its release artifacts."
  },
  "distribution": {
    "registry": "ClawHub",
    "package": "@replynodes-ai/appstore-api",
    "version": "1.0.12",
    "moderation": "pending independent registry verification",
    "public_discovery": false,
    "note": "Registry status is verified independently after publication."
  },
  "capabilities": [
    {
      "capability": "get_app",
      "mcp_tool": "appstore_get_app",
      "operation": "app",
      "method": "GET",
      "path": "/v1/appstore/app",
      "auth_required": false,
      "summary": "Look up one public App Store application"
    },
    {
      "capability": "get_developer",
      "mcp_tool": "appstore_get_developer",
      "operation": "developer",
      "method": "GET",
      "path": "/v1/appstore/developer",
      "auth_required": false,
      "summary": "Look up one public App Store developer"
    },
    {
      "capability": "list_apps",
      "mcp_tool": "appstore_list_apps",
      "operation": "list",
      "method": "GET",
      "path": "/v1/appstore/list",
      "auth_required": false,
      "summary": "List public App Store applications by storefront"
    },
    {
      "capability": "get_privacy",
      "mcp_tool": "appstore_get_privacy",
      "operation": "privacy",
      "method": "GET",
      "path": "/v1/appstore/privacy",
      "auth_required": false,
      "summary": "Look up one public App Store privacy label"
    },
    {
      "capability": "get_ratings",
      "mcp_tool": "appstore_get_ratings",
      "operation": "ratings",
      "method": "GET",
      "path": "/v1/appstore/ratings",
      "auth_required": false,
      "summary": "Get ratings summary for one public App Store application"
    },
    {
      "capability": "get_reviews",
      "mcp_tool": "appstore_get_reviews",
      "operation": "reviews",
      "method": "GET",
      "path": "/v1/appstore/reviews",
      "auth_required": false,
      "summary": "Get paged reviews for one public App Store application"
    },
    {
      "capability": "search_apps",
      "mcp_tool": "appstore_search_apps",
      "operation": "search",
      "method": "GET",
      "path": "/v1/appstore/search",
      "auth_required": false,
      "summary": "Search public App Store applications by term"
    },
    {
      "capability": "get_similar_apps",
      "mcp_tool": "appstore_get_similar_apps",
      "operation": "similar",
      "method": "GET",
      "path": "/v1/appstore/similar",
      "auth_required": false,
      "summary": "List public apps related to one App Store application"
    },
    {
      "capability": "suggest_terms",
      "mcp_tool": "appstore_suggest_terms",
      "operation": "suggest",
      "method": "GET",
      "path": "/v1/appstore/suggest",
      "auth_required": false,
      "summary": "Get type-ahead suggestions for public App Store applications"
    }
  ],
  "unsupported_capabilities": [
    {
      "name": "*write_or_authenticated",
      "status": "unsupported",
      "reason": "read_only_policy",
      "notes": "No purchase, review submission, account, login, or other mutation exists on this boundary, now or later."
    }
  ],
