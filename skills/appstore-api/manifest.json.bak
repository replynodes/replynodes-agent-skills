{
  "manifest_kind": "replynodes/social-data-skills/appstore-data-api-package-manifest",
  "manifest_version": 1,
  "name": "appstore-data-api",
  "title": "App Store Public Reads",
  "description": "Read-only access to public App Store application data: application lookup by track ID or bundle ID, bounded term search, and related-app listings. Requests use Bearer workspace-key authentication or truthful x402 v2 payment negotiation when the service returns HTTP 402. No purchase, review, account, login, or other mutation is supported.",
  "version": "1.0.10",
  "contract_version": "v1",
  "platform": "ios",
  "mode": "readonly",
  "license": "Apache-2.0",
  "entrypoint": "SKILL.md",
  "install_doc": "INSTALL.md",
  "publication_doc": "PUBLICATION.md",
  "required_agents": [
    "OpenClaw",
    "Hermes",
    "ChatGPT",
    "Claude",
    "generic HTTP",
    "MCP agents"
  ],
  "search_terms": [
    "app store",
    "appstore",
    "ios",
    "app lookup",
    "app search",
    "related apps",
    "app metadata",
    "public app data"
  ],
  "surface_status": [
    "This package documents three stable, read-only GET operations with bounded requests and normalized v1 responses.",
    "The public routes are stable capability identifiers for agent tool bindings.",
    "No availability, uptime, latency, success-rate, or payment-settlement claim is made; example payloads are illustrative fixtures."
  ],
  "source_of_truth": {
    "repository": "replynodes/replynodes-agent-skills",
    "path": "skills/appstore-api",
    "purpose": "Public sanitized provenance for the App Store read-skill package and its release artifacts."
  },
  "distribution": {
    "registry": "ClawHub",
    "package": "@replynodes-ai/appstore-api",
    "version": "1.0.10",
    "moderation": "pending independent registry verification",
    "public_discovery": false,
    "note": "Registry status is verified independently after publication."
  },
  "capabilities": [
    {
      "capability": "get_app",
      "mcp_tool": "appstore_get_app",
      "operation": "app",
      "method": "GET",
      "path": "/v1/appstore/app",
      "auth_required": false,
      "summary": "Look up one public App Store application"
    },
    {
      "capability": "search_apps",
      "mcp_tool": "appstore_search_apps",
      "operation": "search",
      "method": "GET",
      "path": "/v1/appstore/search",
      "auth_required": false,
      "summary": "Search public App Store applications by term"
    },
    {
      "capability": "get_similar_apps",
      "mcp_tool": "appstore_get_similar_apps",
      "operation": "similar",
      "method": "GET",
      "path": "/v1/appstore/similar",
      "auth_required": false,
      "summary": "List public apps related to one App Store application"
    }
  ],
  "unsupported_capabilities": [
    {
      "name": "list",
      "status": "unsupported",
      "reason": "deferred_scope",
      "notes": "Storefront ranking crawls; high volume, deferred beyond #15."
    },
    {
      "name": "developer",
      "status": "unsupported",
      "reason": "deferred_scope",
      "notes": "Developer catalog enumeration; deferred beyond #15."
    },
    {
      "name": "reviews",
      "status": "unsupported",
      "reason": "deferred_scope",
      "notes": "Paged user reviews; pagination contract deferred beyond #15."
    },
    {
      "name": "ratings",
      "status": "unsupported",
      "reason": "deferred_scope",
      "notes": "Standalone ratings fetch; already embedded in app records."
    },
    {
      "name": "suggest",
      "status": "unsupported",
      "reason": "deferred_scope",
      "notes": "Type-ahead suggestions; deferred beyond #15."
    },
    {
      "name": "*write_or_authenticated",
      "status": "unsupported",
      "reason": "read_only_policy",
      "notes": "No purchase, review submission, account, login, or authenticated capability exists on this boundary, now or later."
    }
  ],
