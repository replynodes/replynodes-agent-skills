{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/replynodes/replynodes-agent-skills/blob/main/references/company-brief.schema.json",
  "title": "ReplyNodes company brief V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["brief_version", "generated_at", "company", "summary", "products", "target_market", "pricing", "features", "integrations", "customers", "signals", "important_pages", "evidence", "claim_evidence", "unknowns", "coverage_limits", "meta"],
  "properties": {
    "brief_version": {"type": "string", "const": "2.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "company": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "name", "homepage_url"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "homepage_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "summary": {"$ref": "#/$defs/claimSummary"},
    "products": {"$ref": "#/$defs/claims"},
    "target_market": {"$ref": "#/$defs/claims"},
    "features": {"$ref": "#/$defs/claims"},
    "integrations": {"$ref": "#/$defs/claims"},
    "customers": {"$ref": "#/$defs/claims"},
    "pricing": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "plans", "unknown"],
      "properties": {
        "model": {"$ref": "#/$defs/claim"},
        "plans": {"$ref": "#/$defs/claims"},
        "unknown": {"type": "boolean"}
      }
    },
    "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
    "important_pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claim_evidence": {"type": "array", "items": {"$ref": "#/$defs/linkage"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "notable_context": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "brand": {"$ref": "#/$defs/brand"},
    "coverage_limits": {"type": "array", "items": {"type": "string"}},
    "meta": {"$ref": "#/$defs/meta"}
  },
  "$defs": {
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "evidence_ids"],
      "properties": {
        "value": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "brand": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "unknown"],
      "properties": {
        "name": {"type": ["string", "null"], "maxLength": 200},
        "description": {"type": ["string", "null"], "maxLength": 1000},
        "unknown": {"type": "boolean"}
      }
    },
    "claimSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["one_liner", "category", "positioning"],
      "properties": {
        "one_liner": {"$ref": "#/$defs/claim"},
        "category": {"$ref": "#/$defs/claim"},
        "positioning": {"$ref": "#/$defs/claim"}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "url", "evidence_id"],
      "properties": {
        "category": {"type": "string", "enum": ["homepage", "product_features", "pricing_plans", "integrations", "about", "docs", "customers_case_studies", "changelog_blog", "careers", "unknown"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "evidence_id": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_url", "kind", "fetched_at", "excerpt_or_support"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "kind": {"type": "string", "enum": ["first_party", "third_party", "unknown"]},
        "fetched_at": {"type": "string", "format": "date-time"},
        "excerpt_or_support": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "linkage": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_path", "evidence_ids"],
      "properties": {
        "claim_path": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "summary", "observed_at", "recency", "evidence_ids"],
      "properties": {
        "type": {"type": "string", "enum": ["product_launch", "product_direction", "pricing", "partnership", "hiring", "leadership", "market_expansion", "positioning", "customer_momentum", "other"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "observed_at": {"type": "string", "format": "date-time"},
        "published_at": {"type": "string", "format": "date-time"},
        "recency": {"type": "string", "enum": ["dated", "current_observation"]},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "unknown": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "reason"],
      "properties": {
        "field": {"type": "string", "minLength": 1, "maxLength": 100},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "pages_read"],
      "properties": {
        "category": {"type": "string", "enum": ["homepage", "product_features", "pricing_plans", "integrations", "about", "docs", "customers_case_studies", "changelog_blog", "careers", "unknown"]},
        "pages_read": {"type": "integer", "minimum": 0, "maximum": 12}
      }
    },
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["capabilities_used", "tool_calls", "synthesis", "researched_at", "research_goal", "pages_discovered", "pages_attempted", "page_read_count", "page_read_budget_default", "page_read_budget_hard_cap", "partial_failure_count", "source_coverage", "page_contribution"],
      "properties": {
        "capabilities_used": {"type": "array", "items": {"type": "string"}},
        "tool_calls": {"type": "array", "items": {"$ref": "#/$defs/toolCall"}},
        "synthesis": {"type": "string", "const": "host_agent"},
        "researched_at": {"type": "string", "format": "date-time"},
        "research_goal": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "pages_discovered": {"type": "integer", "minimum": 0, "maximum": 1000},
        "pages_attempted": {"type": "integer", "minimum": 0, "maximum": 12},
        "page_read_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "page_read_budget_default": {"type": "integer", "minimum": 0, "maximum": 8},
        "page_read_budget_hard_cap": {"type": "integer", "minimum": 0, "maximum": 12},
        "partial_failure_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "source_coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}},
        "page_contribution": {"type": "array", "items": {"$ref": "#/$defs/contribution"}}
      }
    },
    "contribution": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "category", "read", "claims"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["homepage", "product_features", "pricing_plans", "integrations", "about", "docs", "customers_case_studies", "changelog_blog", "careers", "unknown"]},
        "read": {"type": "boolean"},
        "claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "toolCall": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "operation", "source_url", "http_status", "content_type"],
      "properties": {
        "surface": {"type": "string", "enum": ["free_markdown", "free_homepage_discovery", "free_direct_pricing", "free_brand", "mcp"]},
        "operation": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "endpoint_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "content_type": {"type": "string", "minLength": 1}
      }
    }
  }
}
